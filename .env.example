# Phase 4b — auth gate config (Product B). Copy this file to `.env.local`
# and fill in the password. `.env.local` is gitignored — never commit it.
#
# The gate is OPT-IN: edit mode stays open (no login) until ADMIN_PASSWORD
# is set here. Add it, then restart `next dev` for the change to take.
#
# Local dev: a plaintext password is fine (a console warning appears).
#   ADMIN_PASSWORD=your-password
#
# ⚠️ DO NOT put a bcrypt HASH in a Next .env file. Next loads .env via
# dotenv-expand, which interpolates `$name` as a variable — and a bcrypt
# hash is nothing but `$2y$10$…`. It gets silently eaten and auth never
# matches. (Quoting does NOT help; dotenv strips quotes before expanding.)
#
# For a hash, set it as a REAL environment variable instead (e.g. in your
# host's env config, or `ADMIN_PASSWORD='$2y$…' next start`), which bypasses
# the file loader entirely. Generate a hash with:
#   htpasswd -nbB -C 10 x 'your-password' | cut -d: -f2
# (htpasswd emits $2y$; bcryptjs accepts $2a/$2b/$2y.)
#
# Neither approach: gateway ON requires restarting `next dev` to pick up env
# (env is only read at startup).
#
# ALLOW_EDIT — optional read-only switch for a public self-host (e.g. Vercel).
# Unset (default) = editing available. Set to false/0/no/off to make the
# deployed site read-only (no editor, no shortcut toggle, ?edit=true shows
# nothing). Keeps local dev zero-config.
#   ALLOW_EDIT=false
#
# IMPORTANT: do NOT prefix this with NEXT_PUBLIC_ — that would ship the
# secret to the browser. Leave the name exactly as `ADMIN_PASSWORD`.
ADMIN_PASSWORD=
#
# LOCAL — upload storage switch (tri-state). Unset (default) = auto: use R2
# when its env is configured, else local `public/uploads/` (keeps Product B
# zero-config). `true` forces local `public/uploads/`; `false` forces R2 —
# and `false` without R2 config fails uploads loudly with a hint to set
# R2_ENDPOINT (or R2_ACCOUNT_ID) + keys. USE_LOCAL / STORAGE_LOCAL are
# equivalent aliases. Recognized values per state:
#   true  -> true/1/yes/local/offline
#   false -> false/0/no/r2/remote
#   auto  -> hybrid/auto/both/coexist/mixed (anything else = auto)
# Restart `next dev` after changing it (env is only read at startup).
LOCAL=
#
# ---------------------------------------------------------------------------
# HOSTED STACK (Product A) — everything below is OPTIONAL. Leave it all unset
# for Product B (zero-config localStorage portfolio). The hosted flag that
# switches the app into Product A mode is: Firebase ADMIN keys + KV present
# (`/api/auth/status` -> hosted:true). Client keys alone never activate it.
# Restart `next dev` after changing any of these (env is only read at startup).
# ---------------------------------------------------------------------------
#
# FIREBASE CLIENT (public-safe NEXT_PUBLIC_* — these ship to the browser).
# The first three are required for the hosted login card to function (they
# also gate its lazy bundle: without them the SDK is compiled out entirely —
# FIX-G). Find them in Firebase console -> Project settings -> Your apps.
#   NEXT_PUBLIC_FIREBASE_API_KEY=
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID=
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
#   NEXT_PUBLIC_FIREBASE_APP_ID=
#   NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
#
# NEXT_PUBLIC_SITE_URL — optional canonical site URL (e.g.
# https://you.example.com) used as the metadataBase fallback for absolute
# Open Graph URLs (src/app/layout.tsx). Unset = http://localhost:3000.
# Stay commented unless you set a REAL value: an empty-but-set value would
# crash `new URL(...)` at module load.
#   NEXT_PUBLIC_SITE_URL=
#
# FIREBASE ADMIN (server-side session minting/verification — never public).
# Create a service account (Firebase console -> Project settings -> Service
# accounts) and grant it "Firebase Authentication Admin".
#   FIREBASE_PROJECT_ID      optional if NEXT_PUBLIC_FIREBASE_PROJECT_ID is set
#                            (the client value is used as fallback)
#   FIREBASE_CLIENT_EMAIL    service account email
#   FIREBASE_PRIVATE_KEY     the service account's PEM private key
#
# ⚠️ FIREBASE_PRIVATE_KEY in a .env file: store the key on ONE line with
# literal `\n` where newlines belong — the loader hands it over verbatim and
# admin code converts `\n` -> real newlines. Do NOT paste real newlines into
# the .env file (the parser truncates at the first one) and remember the
# bcrypt `$` warning above applies to any secret-ish value in a .env file —
# for production prefer setting these as REAL environment variables, which
# bypass the file loader entirely.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#
# WORKERS KV — the hosted document store (throwaway Cloudflare account).
# Free tier: 1GB stored / 100K reads/day. Create a namespace + API token
# (Account > Workers KV). GET/PUT of the portfolio JSON goes through
# `src/lib/kv.ts` -> `/api/portfolio`.
#   CLOUDFLARE_ACCOUNT_ID=
#   KV_NAMESPACE_ID=
#   CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
#
# R2 — hosted image storage (S3-compatible, same throwaway account).
# The upload route also accepts documented aliases (R2_BUCKET_NAME,
# CLOUDFLARE_R2_BUCKET, AWS_ACCESS_KEY_ID, … — see the header of
# `src/app/api/upload/route.ts`); the primary names are listed here.
#   R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (or set
#              R2_ACCOUNT_ID and the endpoint is derived)
#   R2_BUCKET= (defaults to `overengineered-portfolio` if unset)
#   R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= (R2 token with Object Write)
#   R2_PUBLIC_URL= optional custom domain; unset -> uploads proxy via /api/r2
#   R2_USER_PREFIX= optional per-user prefix override (default `dev` when no
#              session; signed-in users always get uploads/<uid>/)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_USER_PREFIX=
#
